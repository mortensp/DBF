<Window
    x:Class="DBF.Views.ShellView"
    Title="DBF Tools"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:ctl="clr-namespace:DBF.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:DBF.DataModel"
    Width="1100"
    Height="900"
    FontSize="14"
    WindowState="Normal"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem cal:Message.Attach="[Event Click] = [Action OpenSettingsAsync]" Header="Indstillinger" />
            <MenuItem Header="Hjælp">
                <MenuItem cal:Message.Attach="[Event Click] = [Action TimersHelp]" Header="Bridgeurene" />
                <MenuItem cal:Message.Attach="[Event Click] = [Action ShowAbout]" Header="Om" />
            </MenuItem>
        </Menu>

        <ContentControl x:Name="ActiveItem" Grid.Row="1" />
    </Grid>
</Window>
