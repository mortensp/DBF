<Window x:Name="root"
    x:Class="DBF.Views.TestView"
    Title="MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dm="clr-namespace:DBF.DataModel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userctls="clr-namespace:DBF.UserControls"
    xmlns:views="clr-namespace:DBF.Views"
    xmlns:vm="clr-namespace:DBF.ViewModels"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=vm:TimerSettingsViewModel, IsDesignTimeCreatable=True}"
    d:Background="White"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:Foreground="Black"
    mc:Ignorable="d">

    <StackPanel>
        <views:TimerSettingsView />
    </StackPanel>
</Window>
    
