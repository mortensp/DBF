<Window
    x:Class="DBF.Views.ConfigurationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:ctl="clr-namespace:DBF.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dbf="clr-namespace:DBF"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:DBF.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:DBF.DataModel"
    xmlns:sf="http://schemas.syncfusion.com/wpf"
    Title="{lex:Loc appSettings}"
    lex:LocalizeDictionary.DesignCulture="en-US"
    lex:ResxLocalizationProvider.DefaultAssembly="DBF"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    FontSize="{DynamicResource MediumFontSize}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2" />

                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--<Grid.LayoutTransform>
            <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
        </Grid.LayoutTransform>-->
        <Border
            Padding="12"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="6">

            <StackPanel>

                <Grid Margin="0,0,0,0" DataContext="{Binding NewConfiguration}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--<RowDefinition Height="Auto" />-->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" MinWidth="177" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  General  -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                        Grid.RowSpan="1"
                        Grid.ColumnSpan="2"
                        Margin="0,3,4,0"
                        FontSize="{DynamicResource X-LargeFontSize}"
                        FontWeight="Bold"
                        Text="{lex:Loc General}" />

                    <!--  Start time  -->
                    <!--<TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="10,5,5,0"
                        HorizontalAlignment="Left"
                        Text="Start kl. (standard):" />-->

                    <!--<ctl:TimePicker
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="60"
                        HorizontalAlignment="Left"
                        SelectedTime="{Binding StartTime, Mode=TwoWay}" />-->

                    <!--  Language  -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                        Margin="8,5,4,0"
                        VerticalAlignment="Center"
                        Text="{lex:Loc CultureName}" />

                    <ComboBox Grid.Row="1" Grid.Column="1"
                        Width="140"
                        Margin="0,3,4,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsEditable="False"
                        IsSynchronizedWithCurrentItem="True"
                        ItemsSource="{Binding UILanguages}"
                        SelectedItem="{Binding Culture}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NativeName, Converter={StaticResource CapitalizerConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--  FontSize  -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                        Margin="8,5,4,0"
                        VerticalAlignment="Center"
                        Text="{lex:Loc FontSize}" />

                    <ComboBox Grid.Row="2" Grid.Column="1"
                        Width="140"
                        Margin="0,3,4,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsEditable="False"
                        IsSynchronizedWithCurrentItem="True"
                        ItemsSource="{Binding FontSizes}"
                        SelectedItem="{Binding FontSizeService.FontSize}" />

                    <!--  Read BridgeMate  -->
                    <TextBlock Grid.Row="3" Grid.Column="0"
                        Margin="8,5,4,0"
                        VerticalAlignment="Center"
                        Text="{lex:Loc ReadBM}" />

                    <CheckBox Grid.Row="3" Grid.Column="1"
                        Width="Auto"
                        Margin="0,5,4,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsChecked="{Binding ReadBridgeMate, Mode=TwoWay}" />


                    <!--  BC3:  -->
                    <TextBlock Grid.Row="4" Grid.Column="0"
                        Margin="8,5,4,0"
                        VerticalAlignment="Center"
                        Text="{lex:Loc ReadBC3}" />

                    <CheckBox Grid.Row="4" Grid.Column="1"
                        Width="Auto"
                        Margin="0,5,4,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsChecked="{Binding ReadBC3, Mode=TwoWay}" />

                    <!--<TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="8,3,4,0"
                        VerticalAlignment="Center"
                        Text="BC3 mappe:" />

                    <TextBox
                        Grid.Row="5"
                        Grid.Column="1"
                        Width="Auto"
                        MinWidth="150"
                        Margin="0,5,4,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{Binding BC3Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />-->

                    <!--  Projector  -->
                    <TextBlock Grid.Row="6" Grid.Column="0"
                        Margin="0,7,4,0"
                        FontSize="{DynamicResource X-LargeFontSize}"
                        FontWeight="Bold"
                        Text="{lex:Loc Projector}"
                        Visibility="{Binding ReadBC3, Converter={StaticResource BoolToVis}}" />

                    <!--  Projector Interval:  -->
                    <TextBlock Grid.Row="7" Grid.Column="0"
                        Margin="8,5,4,0"
                        VerticalAlignment="Center"
                        Text="{lex:Loc ProjectorInterval}"
                        Visibility="{Binding ReadBC3, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Grid.Row="7" Grid.Column="1"
                        Margin="0,5,4,0"
                        Orientation="Horizontal"
                        Visibility="{Binding ReadBC3, Converter={StaticResource BoolToVis}}">
                        <TextBox
                            Width="50"
                            Margin="0,3,4,0"
                            Text="{Binding ProjectorInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="4,0,4,0"
                            VerticalAlignment="Center"
                            Text="{lex:Loc Seconds}" />

                    </StackPanel>

                    <!--  Maximum rows  -->

                    <TextBlock Grid.Row="8" Grid.Column="0"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        Text="{lex:Loc MaxRows}"
                        Visibility="{Binding ReadBC3, Converter={StaticResource BoolToVis}}" />

                    <TextBox Grid.Row="8" Grid.Column="1"
                        Width="50"
                        Margin="0,5,0,5"
                        HorizontalAlignment="Left"
                        Text="{Binding ProjectorMaxRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding ReadBC3, Converter={StaticResource BoolToVis}}" />

                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                cal:Message.Attach="[Event Click] = [Action Cancel]"
                Content="{lex:Loc btnCancel}"
                IsCancel="True" />
            <Button
                Width="80"
                cal:Message.Attach="[Event Click] = [Action AcceptSetting]"
                Content="{lex:Loc btnAccept}"
                IsDefault="True" />
        </StackPanel>
    </Grid>

</Window>
