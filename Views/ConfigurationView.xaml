<Window
    x:Class="DBF.Views.ConfigurationView"
    Title="Indstillinger"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dbf="clr-namespace:DBF"
    xmlns:local="clr-namespace:DBF.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:DBF.DataModel"
    xmlns:sf="http://schemas.syncfusion.com/wpf"
    Width="400"
    Height="250"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2" />

                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Padding="12"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="6">

            <StackPanel>

                <Grid DataContext="{Binding NewConfiguration}" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Generelt  -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                        Margin="0,0,0,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="Generelt:" />

                    <!--  BC3 mappe:  -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        Text="BC3 mappe:" />

                    <TextBox Grid.Row="1" Grid.Column="1"
                        Width="Auto"
                        MinWidth="150"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{Binding BC3Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Projector  -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="Projektor:" />

                    <!--  Projector Interval:  -->
                    <TextBlock Grid.Row="3" Grid.Column="0"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        Text="Bladringsinterval på projektor:" />

                    <StackPanel Grid.Row="3" Grid.Column="1"
                        Margin="0,5,0,5"
                        Orientation="Horizontal">
                        <TextBox
                            Width="50"
                            Margin="0,0,4,0"
                            Text="{Binding ProjectorInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="4,0,4,0"
                            VerticalAlignment="Center"
                            Text="sekunder" />

                    </StackPanel>

                    <!--  Maximum rows  -->

                    <TextBlock Grid.Row="4" Grid.Column="0"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        Text="Max linjer af gangen :" />

                    <TextBox Grid.Row="4" Grid.Column="1"
                        Width="50"
                        Margin="0,5,0,5"
                        HorizontalAlignment="Left"
                        Text="{Binding ProjectorMaxRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                cal:Message.Attach="[Event Click] = [Action Cancel]"
                Content="Annuller"
                IsCancel="True" />
            <Button
                Width="80"
                cal:Message.Attach="[Event Click] = [Action AcceptSetting]"
                Content="Anvend"
                IsDefault="True" />
        </StackPanel>
    </Grid>

</Window>
