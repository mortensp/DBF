<UserControl
    x:Class="DBF.Views.TestReport4View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lib="clr-namespace:PrintWPF;assembly=PrintWPF"
    xmlns:local="clr-namespace:DBF.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="400"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header that appears on first page only  -->
        <StackPanel Grid.Row="0" lib:Reporting.VisibleOnFirstPageOnly="True">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Text="Report Header4" />

            <TextBlock Text="This header is only visible on the first page." TextAlignment="Center" />
        </StackPanel>

        <!--  List header  -->
        <StackPanel x:Name="DetailsRegion" Grid.Row="1">

            <Grid
                Grid.Row="1"
                Margin="0,10,0,0"
                Visibility="{Binding ElementName=ReportList, Path=Visibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.2*" />
                    <ColumnDefinition Width="0.6*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    BorderBrush="Black"
                    BorderThickness="1,1,0,1">
                    <TextBlock
                        Margin="3"
                        FontWeight="Bold"
                        Text="ID" />
                </Border>

                <Border
                    Grid.Column="1"
                    BorderBrush="Black"
                    BorderThickness="1,1,0,1">
                    <TextBlock
                        Margin="3"
                        FontWeight="Bold"
                        Text="Name" />
                </Border>

                <Border
                    Grid.Column="2"
                    BorderBrush="Black"
                    BorderThickness="1,1,1,1">
                    <TextBlock
                        Margin="3"
                        FontWeight="Bold"
                        Text="Description" />
                </Border>
            </Grid>

            <!--  List body  -->
            <ItemsControl
                x:Name="ReportList"
                Grid.Row="2"
                ItemsSource="{Binding ReportList}"
                d:ItemsSource="{Binding Items}"
                lib:Reporting.Paginate="True">
                <ItemsControl.ItemTemplate>

                    <DataTemplate DataType="{x:Type local:ReportDataRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.2*" />
                                <ColumnDefinition Width="0.6*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                BorderBrush="Black"
                                BorderThickness="1,0,0,1">
                                <TextBlock Margin="3" Text="{Binding Id}" />
                            </Border>

                            <Border
                                Grid.Column="1"
                                BorderBrush="Black"
                                BorderThickness="1,0,0,1">
                                <TextBlock Margin="3" Text="{Binding Name}" />
                            </Border>

                            <Border
                                Grid.Column="2"
                                BorderBrush="Black"
                                BorderThickness="1,0,1,1">
                                <TextBlock Margin="3" Text="{Binding Description}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <!--  Footer  -->
        <Grid Grid.Row="3">
            <TextBlock HorizontalAlignment="Left">
                <Run Text="Date:" /> <Run Text="{Binding Source={x:Static sys:DateTime.Now}, Mode=OneWay, StringFormat=d}" />
            </TextBlock>

            <TextBlock HorizontalAlignment="Right">
                <Run Text="Page:" />
                <Run lib:Reporting.SetCurrentPageNumberAttachedProperty="True" Text="{Binding (lib:Reporting.CurrentPageNumber), Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                <Run Text="(" /><Run lib:Reporting.SetLastPageNumberAttachedProperty="True" Text="{Binding (lib:Reporting.LastPageNumber), Mode=OneWay, RelativeSource={RelativeSource Self}}" /><Run Text=")" />
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
