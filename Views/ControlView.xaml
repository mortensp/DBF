<UserControl
    x:Class="DBF.Views.ControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:ctl="clr-namespace:DBF.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:DBF.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sf="http://schemas.syncfusion.com/wpf"
    x:Name="root"
    d:Background="White"
    lex:LocalizeDictionary.DesignCulture="en-US"
    lex:ResxLocalizationProvider.DefaultAssembly="DBF"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    MouseDown="UserControl_MouseDown"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,8"
            Visibility="{Binding DataContext.Parent.FullScreenMode, ElementName=root}">
            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Visibility="{Binding BC3Available, Converter={StaticResource BooleanToVisibilityConverter}}">

                <!--  BridgeCenter ie. Mainclub  -->
                <Label Content="{lex:Loc Club}" FontWeight="Bold" />

                <TextBlock
                    Margin="-4,4,5,0"
                    FontWeight="Bold"
                    Text=":" />

                <ComboBox
                    Name="cmbClubNo"
                    Width="Auto"
                    MinWidth="100"
                    MaxHeight="20"
                    Padding="4,1"
                    HorizontalAlignment="Left"
                    cal:Message.Attach="[Event DropDownOpened] = [Action ResetBadges]"
                    local:ComboBoxAutoScrollBehavior.AutoScroll="True"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding MainClubs}"
                    SelectedItem="{Binding SelectedMainClub, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <sf:SfBadge
                    Width="25"
                    Background="LightBlue"
                    Content="{Binding MainClubBadge}"
                    Foreground="Black"
                    HorizontalAnchor="Inside" />

                <!--  Subclub  -->
                <Label Content="{lex:Loc Subclub}" FontWeight="Bold" />

                <TextBlock
                    Margin="-4,4,5,0"
                    FontWeight="Bold"
                    Text=":" />

                <ComboBox
                    Name="cmbClub"
                    Width="Auto"
                    MinWidth="100"
                    MaxHeight="20"
                    Padding="4,1"
                    HorizontalAlignment="Left"
                    cal:Message.Attach="[Event DropDownOpened] = [Action ResetBadges]"
                    local:ComboBoxAutoScrollBehavior.AutoScroll="True"
                    ItemsSource="{Binding Clubs}"
                    SelectedItem="{Binding SelectedClub, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <sf:SfBadge
                    Width="25"
                    Background="LightBlue"
                    Content="{Binding SubClubBadge}"
                    Foreground="Black" />

                <!--  Playing date and time  -->
                <WrapPanel>
                    <Label Content="{lex:Loc Date}" FontWeight="Bold" />

                    <TextBlock
                        Margin="-4,4,5,0"
                        FontWeight="Bold"
                        Text=":" />
                </WrapPanel>

                <ComboBox
                    Name="cmbDate"
                    Width="Auto"
                    MinWidth="100"
                    MaxHeight="20"
                    Padding="4,1"
                    HorizontalAlignment="Left"
                    cal:Message.Attach="[Event DropDownOpened] = [Action ResetBadges]"
                    local:ComboBoxAutoScrollBehavior.AutoScroll="True"
                    ItemsSource="{Binding PlayingTimes}"
                    SelectedItem="{Binding SelectedPlayingTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <sf:SfBadge
                    Width="25"
                    Background="LightBlue"
                    Content="{Binding DateBadge}"
                    Foreground="Black" />

                <!--  Toast overlay  -->
                <!--
                <Grid
                    x:Name="ToastHost"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False" />-->
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Visibility="{Binding BC3Available, Converter={StaticResource VisibilityInvertConverter}}">

                <!--  Start time  -->
                <TextBlock
                    Margin="10,5,5,0"
                    HorizontalAlignment="Left"
                    FontWeight="Bold"
                    Text="{lex:Loc StartTime}" />
                <TextBlock
                    Margin="-4,4,5,0"
                    FontWeight="Bold"
                    Text=":" />

                <ctl:TimePicker SelectedTime="{Binding Configuration.StartTime, Mode=TwoWay}" />

            </StackPanel>

            <!--  Calculated end time  -->
            <TextBlock
                Margin="10,5,5,0"
                HorizontalAlignment="Left"
                FontWeight="Bold"
                Text="{lex:Loc ExpectedEndTime}" />

            <TextBlock
                Margin="-4,4,5,0"
                FontWeight="Bold"
                Text=":" />

            <TextBlock
                x:Name="Configuration_EndTime"
                Margin="0,5"
                HorizontalAlignment="Left"
                FontWeight="Bold" />



        </WrapPanel>

        <Border Grid.Row="1" Grid.Column="2"
            Height="28"
            Visibility="{Binding ErrorMessage.Value, Converter={StaticResource HideEmptyConverter}}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#E10000"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White"
                Text="{Binding ErrorMessage}" />
        </Border>

        <TabControl Grid.Row="2"
            Grid.ColumnSpan="2"
            MinHeight="400">

            <TabItem Header="{lex:Loc BridgeTimers}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Top: buttons  -->
                    <DockPanel Grid.Row="0"
                        Margin="5,4,5,0"
                        LastChildFill="False"
                        Visibility="{Binding DataContext.Parent.FullScreenMode, ElementName=root}">


                        <Button
                            x:Name="AddTimer"
                            Width="70"
                            Content="{lex:Loc AddTimer}"
                            DockPanel.Dock="Left"
                            IsEnabled="{Binding Configuration.CanAndTimer}" />

                        <Button
                            Width="40"
                            Height="25"
                            cal:Message.Attach="[Event Click] = [Action ToggleWindowOrientation]"
                            DockPanel.Dock="Right">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Configuration.WindowOrientation}" Value="Vertical">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="/Images/VerticalWindows.PNG" />
                        </Button>

                        <Button
                            Width="40"
                            Height="25"
                            Margin="5,0"
                            cal:Message.Attach="[Event Click] = [Action ToggleWindowOrientation]"
                            DockPanel.Dock="Right">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Configuration.WindowOrientation}" Value="Horizontal">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                            <Image Source="/Images/HorizontalWindows.PNG" />
                        </Button>
                    </DockPanel>

                    <!--  main part: the TimersPanel  -->
                    <Viewbox Grid.Row="1">
                        <ctl:TimersPanel
                            BridgeTimers="{Binding Configuration.BridgeTimers}"
                            CanAndTimer="{Binding Configuration.CanAndTimer}"
                            Orientation="{Binding Configuration.WindowOrientation}" />
                    </Viewbox>
                </Grid>
            </TabItem>


            <TabItem Header="{lex:Loc Startlist}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ctl:StartListControl x:Name="startListControl" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{lex:Loc Results}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ctl:ResultsControl x:Name="resultsControl" />
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Label Grid.Row="3" Grid.Column="0"
            Content="{lex:Loc Projector}"
            FontWeight="Bold"
            Visibility="{Binding DataContext.Parent.FullScreenMode, ElementName=root}" />

        <WrapPanel Grid.Row="3" Grid.Column="1"
            Margin="10,0,10,0"
            HorizontalAlignment="Center"
            Visibility="{Binding DataContext.Parent.FullScreenMode, ElementName=root}">
            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action ShowStartListAsync]"
                Content="{lex:Loc btnShowStartLists}" />
            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action ShowBridgeTimersAsync]"
                Content="{lex:Loc btnShowBridgeTimers}" />
            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action ShowResultsAsync]"
                Content="{lex:Loc btnShowResults}" />

            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action CloseProjector]"
                Content="{lex:Loc btnClose}" />
        </WrapPanel>
    </Grid>

</UserControl>
