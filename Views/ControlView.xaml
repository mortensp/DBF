<UserControl
    x:Class="DBF.Views.ControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Notification="clr-namespace:Syncfusion.Windows.Controls.Notification;assembly=Syncfusion.SfBusyIndicator.WPF"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:ctl="clr-namespace:DBF.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:help="clr-namespace:DBF.HelpSystem"
    xmlns:helpers="clr-namespace:DBF.Helpers"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:DBF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sf="http://schemas.syncfusion.com/wpf"
    x:Name="root"
    d:Background="White"
    lex:LocalizeDictionary.DesignCulture="en-US"
    lex:ResxLocalizationProvider.DefaultAssembly="DBF"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    MouseDown="UserControl_MouseDown"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="343*" />
            <ColumnDefinition Width="369*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row 0  -->

        <WrapPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,0,0,2"
            Background="White"
            Visibility="{Binding DataContext.Parent.FullScreenVisibility, ElementName=root}">
            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Visibility="{Binding BC3Available, Converter={StaticResource BooleanToVisibilityConverter}}">

                <!--  BridgeCenter ie. Mainclub  -->
                <Label Content="{lex:Loc Club}" FontWeight="SemiBold" />

                <TextBlock
                    Margin="-4,4,5,0"
                    FontWeight="SemiBold"
                    Text=":" />

                <ComboBox
                    Name="cmbClubNo"
                    Width="Auto"
                    MinWidth="100"
                    MaxHeight="20"
                    Padding="4,1"
                    HorizontalAlignment="Left"
                    cal:Message.Attach="[Event DropDownOpened] = [Action ResetBadges]"
                    helpers:ComboBoxAutoScrollBehavior.AutoScroll="True"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding MainClubs}"
                    SelectedItem="{Binding SelectedMainClub, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <sf:SfBadge
                    Width="25"
                    Background="LightBlue"
                    Content="{Binding MainClubBadge}"
                    Foreground="Black"
                    HorizontalAnchor="Inside" />

                <!--  Subclub  -->
                <Label Content="{lex:Loc Subclub}" FontWeight="SemiBold" />

                <TextBlock
                    Margin="-4,4,5,0"
                    FontWeight="SemiBold"
                    Text=":" />

                <ComboBox
                    Name="cmbClub"
                    Width="Auto"
                    MinWidth="100"
                    MaxHeight="20"
                    Padding="4,1"
                    HorizontalAlignment="Left"
                    cal:Message.Attach="[Event DropDownOpened] = [Action ResetBadges]"
                    helpers:ComboBoxAutoScrollBehavior.AutoScroll="True"
                    ItemsSource="{Binding Clubs}"
                    SelectedItem="{Binding SelectedClub, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Notification:SfBusyIndicator
                    AnimationType="Gear"
                    Grid.ZIndex="9999"
                    Header="Indlæser..."
                    IsBusy="{Binding IsBusy}"
                    IsHitTestVisible="False" />

                <sf:SfBadge
                    Width="25"
                    Background="LightBlue"
                    Content="{Binding SubClubBadge}"
                    Foreground="Black" />

                <!--  Playing date and time  -->
                <WrapPanel>
                    <Label Content="{lex:Loc Date}" FontWeight="SemiBold" />

                    <TextBlock
                        Margin="-4,4,5,0"
                        FontWeight="SemiBold"
                        Text=":" />
                </WrapPanel>

                <ComboBox
                    Name="cmbDate"
                    Width="Auto"
                    MinWidth="100"
                    MaxHeight="20"
                    Padding="4,3,1,1"
                    HorizontalAlignment="Left"
                    cal:Message.Attach="[Event DropDownOpened] = [Action ResetBadges]"
                    helpers:ComboBoxAutoScrollBehavior.AutoScroll="True"
                    ItemsSource="{Binding PlayingTimes}"
                    SelectedItem="{Binding SelectedPlayingTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                FontFamily="Cascadia Code"
                                FontSize="{DynamicResource MediumFontSize}"
                                Text="{Binding Date, StringFormat='dd MMM yy  HH:mm'}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <sf:SfBadge
                    Width="25"
                    Background="LightBlue"
                    Content="{Binding DateBadge}"
                    Foreground="Black" />


            </StackPanel>

            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Visibility="{Binding BC3Available, Converter={StaticResource VisibilityInvertConverter}}">

                <!--  Start time  -->
                <TextBlock
                    Margin="10,5,5,0"
                    HorizontalAlignment="Left"
                    FontWeight="SemiBold"
                    Text="{lex:Loc StartTime}" />
                <TextBlock
                    Margin="-4,4,5,0"
                    FontWeight="SemiBold"
                    Text=":" />

                <ctl:TimePicker SelectedTime="{Binding Configuration.StartTime, Mode=TwoWay}" />

            </StackPanel>

            <!--  Calculated end time  -->
            <TextBlock
                Margin="10,5,5,0"
                HorizontalAlignment="Left"
                FontWeight="SemiBold"
                Text="{lex:Loc ExpectedEndTime}" />

            <TextBlock
                Margin="-4,4,5,0"
                FontWeight="SemiBold"
                Text=":" />

            <TextBlock
                Margin="0,7,0,0"
                HorizontalAlignment="Left"
                FontFamily="Cascadia Code"
                FontSize="{DynamicResource MediumFontSize}"
                FontWeight="SemiBold"
                Text="{Binding Configuration.EndTime, StringFormat='HH:mm'}" />
        </WrapPanel>

        <!--  Row 1  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Height="28"
            Visibility="{Binding ErrorMessage.Value, Converter={StaticResource HideEmptyConverter}}" Grid.ColumnSpan="2" Margin="0,0,0,527" Grid.RowSpan="2">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#E10000"
                FontSize="{DynamicResource X-LargeFontSize}"
                FontWeight="Bold"
                Foreground="White"
                Text="{Binding ErrorMessage}" />
        </Border>

        <TabControl
            Grid.Row="2"
            Grid.ColumnSpan="3"
            MinHeight="400"
            SelectedIndex="1">


            <TabItem Header="{lex:Loc Startlist}" Visibility="{Binding Configuration.ReadBC3, Converter={StaticResource BoolToVis}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ctl:StartListControl x:Name="startListControl" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{lex:Loc BridgeTimers}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Tab Item Top: buttons  -->
                    <DockPanel
                        Grid.Row="0"
                        Margin="5,4,5,0"
                        LastChildFill="False"
                        Visibility="{Binding DataContext.Parent.FullScreenVisibility, ElementName=root}">
                        <Button
                            x:Name="AddTimer"
                            Width="70"
                            Content="{lex:Loc AddTimer}"
                            DockPanel.Dock="Left"
                            IsEnabled="{Binding Configuration.CanAndTimer}" />

                        <Button
                            x:Name="btnHelp"
                            Width="40"
                            Height="25"
                            help:Help.Key="AppSettings"
                            help:HelpBehavior.Attach="True"
                            DockPanel.Dock="Right"
                            Visibility="Collapsed">
                            <icons:MaterialDesign
                                Width="12"
                                Height="12"
                                Kind="QuestionMarkOutline" />

                        </Button>

                        <Button
                            Width="40"
                            Height="25"
                            cal:Message.Attach="[Event Click] = [Action ToggleWindowOrientation]"
                            DockPanel.Dock="Right"
                            Visibility="{Binding Configuration.WindowOrientationVisibility}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Configuration.WindowOrientation}" Value="Vertical">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="/Images/VerticalWindows.PNG" />
                        </Button>

                        <Button
                            Width="40"
                            Height="25"
                            Margin="5,0"
                            cal:Message.Attach="[Event Click] = [Action ToggleWindowOrientation]"
                            DockPanel.Dock="Right"
                            Visibility="{Binding Configuration.WindowOrientationVisibility}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Configuration.WindowOrientation}" Value="Horizontal">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                            <Image Source="/Images/HorizontalWindows.PNG" />
                        </Button>
                    </DockPanel>

                    <!--  Tab Item Main part: the TimersPanel  -->
                    <Viewbox Name="ControlViewbox" Grid.Row="1">
                        <ctl:TimersPanel
                            BridgeTimers="{Binding Configuration.BridgeTimers}"
                            CanAndTimer="{Binding Configuration.CanAndTimer}"
                            Orientation="{Binding Configuration.WindowOrientation}" />
                    </Viewbox>
                </Grid>
            </TabItem>


            <TabItem Header="{lex:Loc Results}" Visibility="{Binding Configuration.ReadBC3, Converter={StaticResource BoolToVis}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ctl:ResultsControl x:Name="resultsControl" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{lex:Loc Print}" Visibility="{Binding Configuration.InDebugMode, Converter={StaticResource BoolToVis}}">
                <!--<ctl:StartListPrintControl x:Name="printControl" />-->
                <ctl:PrintableGridView x:Name="printControl" />
            </TabItem>
        </TabControl>

        <!--  Row 3  -->
        <Label
            Grid.Row="2"
            Grid.Column="0"
            Content="{lex:Loc Projector}"
            FontWeight="Bold"
            Visibility="{Binding DataContext.Parent.FullScreenVisibility, ElementName=root}" Grid.ColumnSpan="2" Margin="0,527,343,0" Grid.RowSpan="2" />

        <WrapPanel
            Grid.Row="2"
            Grid.Column="1"
            Margin="136,527,0,0"
            HorizontalAlignment="Left"
            Visibility="{Binding DataContext.Parent.FullScreenVisibility, ElementName=root}" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action ShowStartListAsync]"
                Content="{lex:Loc btnShowStartLists}"
                Visibility="{Binding DataContext.Parent.ListsVisibility, ElementName=root}" />
            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action ShowBridgeTimersAsync]"
                Content="{lex:Loc btnShowBridgeTimers}" />
            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action ShowResultsAsync]"
                Content="{lex:Loc btnShowResults}"
                Visibility="{Binding DataContext.Parent.ListsVisibility, ElementName=root}" />

            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action CloseProjector]"
                Content="{lex:Loc btnClose}" />
        </WrapPanel>
    </Grid>

</UserControl>
