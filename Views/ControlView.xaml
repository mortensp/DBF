<UserControl x:Name="root"
    x:Class="DBF.Views.ControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:ctl="clr-namespace:DBF.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="White"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:ResxLocalizationProvider.DefaultAssembly="DBF"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,8"
            Visibility="{Binding DataContext.Parent.FullScreenMode, ElementName=root}">

            <!--  Bridge Center or Mainclub  -->
            <Label Content="{lex:Loc Club}" FontWeight="Bold" />
            <TextBlock Text=":"
                Margin="-4,4,5,0"
                FontWeight="Bold" />

            <ComboBox Name="cmbClubNo"
                Width="Auto"
                MinWidth="100"
                MaxHeight="20"
                Padding="4,1"
                HorizontalAlignment="Left"
                DisplayMemberPath="Name"
                ItemsSource="{Binding MainClubs}"
                SelectedItem="{Binding SelectedMainClub, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Visibility="{Binding BC3Available, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!--  Under the subclub name  -->
                <Label Content="{lex:Loc Subclub}" FontWeight="Bold" />
                <TextBlock Text=":"
                    Margin="-4,4,5,0"
                    FontWeight="Bold" />

                <ComboBox Name="cmbClub"
                    Width="Auto"
                    MinWidth="100"
                    MaxHeight="20"
                    Padding="4,1"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding Clubs}"
                    SelectedItem="{Binding SelectedClub, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Playing date and time  -->
                <WrapPanel Grid.Row="0" Grid.Column="0">
                    <Label Content="{lex:Loc Date}" FontWeight="Bold" />

                    <TextBlock Text=":"
                        Margin="-4,4,5,0"
                        FontWeight="Bold" />
                </WrapPanel>

                <ComboBox Name="cmbDate"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="Auto"
                    MinWidth="100"
                    MaxHeight="20"
                    Padding="4,1"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding PlayingTimes}"
                    SelectedItem="{Binding SelectedPlayingTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Visibility="{Binding BC3Available, Converter={StaticResource VisibilityInvertConverter}}">

                <!--  Start time  -->
                <TextBlock Text="{lex:Loc StartTime}"
                    Margin="10,5,5,0"
                    HorizontalAlignment="Left"
                    FontWeight="Bold" />
                <TextBlock Text=":"
                    Margin="-4,4,5,0"
                    FontWeight="Bold" />

                <ctl:TimePicker SelectedTime="{Binding Configuration.StartTime, Mode=TwoWay}" />

            </StackPanel>

            <!--  Calculated end time  -->
            <TextBlock Text="{lex:Loc ExpectedEndTime}"
                Margin="10,5,5,0"
                HorizontalAlignment="Left"
                FontWeight="Bold" />

            <TextBlock Text=":"
                Margin="-4,4,5,0"
                FontWeight="Bold" />

            <TextBlock x:Name="Configuration_EndTime"
                Margin="0,5"
                HorizontalAlignment="Left"
                FontWeight="Bold" />

        </WrapPanel>

        <Border
            Grid.Row="1"
            Grid.Column="2"
            Height="28"
            Visibility="{Binding ErrorMessage, Converter={StaticResource HideEmptyConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Red"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White" />
        </Border>

        <TabControl
            Grid.Row="2"
            Grid.ColumnSpan="2"
            MinHeight="400">

            <TabItem Header="{lex:Loc BridgeTimers}">
                <WrapPanel>
                    <WrapPanel
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Margin="5,4,5,0">
                        <Button x:Name="AddTimer"
                            Width="70"
                            cal:Message.Attach="[Event Click] = [Action AddTimer]"
                            Content="{lex:Loc AddTimer}"
                            IsEnabled="{Binding Configuration.TimersCanBeAdded}"
                            Visibility="{Binding DataContext.Parent.FullScreenMode, ElementName=root}" />

                        <Button x:Name="btnTest"
                            Width="70"
                            cal:Message.Attach="[Event Click] = [Action Test]"
                            Content="Test"
                            Visibility="Collapsed" />
                    </WrapPanel>

                    <Viewbox>
                        <ctl:TimersPanel Timers="{Binding Configuration.BridgeTimers}" TimersCanBeAdded="{Binding Configuration.TimersCanBeAdded}" />
                    </Viewbox>
                </WrapPanel>
            </TabItem>

            <TabItem Header="{lex:Loc Startlist}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ctl:StartListControl x:Name="startListControl" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{lex:Loc Results}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ctl:ResultsControl x:Name="resultsControl" />
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Label
            Grid.Row="3"
            Grid.Column="0"
            Content="{lex:Loc Projector}"
            FontWeight="Bold"
            Visibility="{Binding DataContext.Parent.FullScreenMode, ElementName=root}" />

        <WrapPanel
            Grid.Row="3"
            Grid.Column="1"
            Margin="10,0,10,0"
            HorizontalAlignment="Center"
            Visibility="{Binding DataContext.Parent.FullScreenMode, ElementName=root}">
            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action ShowStartList]"
                Content="{lex:Loc btnShowStartLists}" />
            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action ShowBridgeTimers]"
                Content="{lex:Loc btnShowBridgeTimers}" />
            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action ShowResults]"
                Content="{lex:Loc btnShowResults}" />

            <Button
                Width="100"
                Margin="5"
                cal:Message.Attach="[Event Click] = [Action CloseProjector]"
                Content="{lex:Loc btnClose}" />
        </WrapPanel>
    </Grid>

</UserControl>
