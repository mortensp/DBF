<UserControl
    x:Class="DBF.Views.TestReport1bView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lib="clr-namespace:PrintWPF;assembly=PrintWPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="410"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="White">
        <!--  Header that appears on first page only  -->
        <Border Background="White">
            <DockPanel Margin="40" LastChildFill="True">

                <!--  HEADER  -->
                <StackPanel
                    Margin="0,0,0,20"
                    lib:Reporting.VisibleOnFirstPageOnly="True"
                    DockPanel.Dock="Top">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="Report Header1" />

                    <TextBlock Text="This header is only visible on the first page." TextAlignment="Center" />
                </StackPanel>

                <!--  FOOTER  -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator />
                    <Grid Margin="0,10,0,00">
                        <TextBlock HorizontalAlignment="Left">
                            <Run Text="Date:" /> <Run Text="{Binding Source={x:Static sys:DateTime.Now}, Mode=OneWay, StringFormat=d}" />
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Right">
                            <Run Text="Page:" />
                            <Run lib:Reporting.SetCurrentPageNumberAttachedProperty="True" Text="{Binding (lib:Reporting.CurrentPageNumber), Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                            <Run Text="(" /><Run lib:Reporting.SetLastPageNumberAttachedProperty="True" Text="{Binding (lib:Reporting.LastPageNumber), Mode=OneWay, RelativeSource={RelativeSource Self}}" /><Run Text=")" />
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <!--  DETAILS (fleksibel højde)  -->
                <Grid x:Name="DetailsRegion" VerticalAlignment="Top">
                    <!--  DataGrid with paginization support  -->
                    <DataGrid
                        x:Name="ReportDgList"
                        Width="400"
                        VerticalAlignment="Stretch"
                        d:ItemsSource="{Binding Items}"
                        lib:Reporting.Paginate="True"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="True"
                        CanUserResizeRows="False"
                        CanUserSortColumns="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding ReportList}">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="0.2*"
                                Binding="{Binding Id}"
                                Header="ID"
                                IsReadOnly="True" />

                            <DataGridTextColumn
                                Width="0.6*"
                                Binding="{Binding Name}"
                                Header="Name"
                                IsReadOnly="True" />

                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Description}"
                                Header="Description"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</UserControl>
