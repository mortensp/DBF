<Window
    x:Class="DBF.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DBF.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DBF.ViewModels"
    Title="{lex:Loc AboutTitle}"
    Width="650"
    Height="500"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    lex:LocalizeDictionary.DesignCulture="en-US"
    lex:ResxLocalizationProvider.DefaultAssembly="DBF"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    Padding="20"
    d:DataContext="{d:DesignInstance vm:AboutViewModel,
                                     IsDesignTimeCreatable=True}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Background="#F0F0F0">
        <Border
            Padding="20"
            Background="White"
            CornerRadius="10"
            Effect="{DynamicResource DropShadowEffect}">
            <StackPanel>
                <!--  Logo  -->
                <Image
                    Width="120"
                    Height="120"
                    Source="pack://application:,,,/Images/DBF_Tools.ICO"
                    Stretch="Uniform" />

                <!--  Text  -->
                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="#2C3E50"
                    Text="{Binding AppName}"
                    TextAlignment="Center" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="14"
                    Foreground="#7F8C8D"
                    Text="{Binding Version}"
                    TextAlignment="Center" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="14"
                    Foreground="#7F8C8D"
                    Text="{Binding Author}"
                    TextAlignment="Center" />
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="16"
                    Foreground="#34495E"
                    Text="{lex:Loc Description}"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />

                <!--  Close button  -->
                <Button
                    Width="80"
                    Margin="0,20,0,0"
                    Padding="5"
                    HorizontalAlignment="Center"
                    cal:Message.Attach="Close"
                    Content="{lex:Loc btnClose}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
