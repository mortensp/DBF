<UserControl
    x:Class="DBF.Views.TestReport2View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lib="clr-namespace:PrintWPF;assembly=PrintWPF"
    xmlns:local="clr-namespace:DBF.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    x:Name="RootControl"
    d:DesignHeight="400"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid x:Name="grid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="20"
            HorizontalAlignment="Center"
            FontSize="42"
            Text="Test Report 2" />

        <Grid x:Name="DetailsRegion" Grid.Row="1">
            <ListView
                x:Name="ListView"
                Grid.Row="1"
                
        ItemsSource="{Binding ReportList}"                lib:Reporting.Paginate="True"
                AlternationCount="2"
                SizeChanged="ListView_OnSizeChanged">
                <ListView.View>
                    <GridView x:Name="gridView">
                        <GridViewColumn Width="50" Header="ID">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type local:ReportDataRow}">
                                    <TextBlock x:Name="IdCell" Text="{Binding Id}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(ListView.AlternationIndex)}" Value="0">
                                            <Setter TargetName="IdCell" Property="Foreground" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(ListView.AlternationIndex)}" Value="1">
                                            <Setter TargetName="IdCell" Property="Foreground" Value="DodgerBlue" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn
                            Width="100"
                            DisplayMemberBinding="{Binding Name}"
                            Header="Name" />

                        <!--  Description column width is changed in code behind  -->
                        <GridViewColumn
                            Width="200"
                            DisplayMemberBinding="{Binding Description}"
                            Header="Description" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!--  Footer  -->
        <Grid Grid.Row="2" Margin="0,10,0,00">
            <TextBlock HorizontalAlignment="Left">
                <Run Text="Date:" /> <Run Text="{Binding Source={x:Static sys:DateTime.Now}, Mode=OneWay, StringFormat=d}" />
            </TextBlock>

            <TextBlock HorizontalAlignment="Right">
                <Run Text="Page:" />
                <Run lib:Reporting.SetCurrentPageNumberAttachedProperty="True" Text="{Binding (lib:Reporting.CurrentPageNumber), Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                <Run Text="(" /><Run lib:Reporting.SetLastPageNumberAttachedProperty="True" Text="{Binding (lib:Reporting.LastPageNumber), Mode=OneWay, RelativeSource={RelativeSource Self}}" /><Run Text=")" />
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
