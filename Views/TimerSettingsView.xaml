<Window x:Name="root"
    x:Class="DBF.Views.TimerSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:audio="clr-namespace:DBF.AudioServices"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:ctl="clr-namespace:DBF.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dbf="clr-namespace:DBF"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:DBF.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:DBF.DataModel"
    xmlns:sf="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="{lex:Loc TimerSettings}"
    Width="605"
    Height="647"
    lex:LocalizeDictionary.DesignCulture="da"
    lex:ResxLocalizationProvider.DefaultAssembly="DBF"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2" />

                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Make this scrollable  -->
        <ScrollViewer
            Grid.Row="0"
            CanContentScroll="True"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">

            <Border
                Padding="12"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="6">

                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{lex:Loc SetClock}"
                            Margin="0,0,0,12"
                            FontSize="16"
                            FontWeight="Bold" />

                        <TextBlock Text="{Binding Message}"
                            Margin="70,0,0,12"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="Red" />
                    </WrapPanel>

                    <Grid Margin="0,0,0,0" DataContext="{Binding NewSetting}">
                        <Grid.RowDefinitions>
                            <!--  Add a row for each field  -->
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Row: Group(s):  -->
                        <TextBlock Text="{lex:Loc Groups}"
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <ctl:EnumFlagsControl
                            Grid.Row="0"
                            Grid.Column="1"
                            EnumType="{x:Type model:GroupFlags}"
                            Orientation="Horizontal"
                            SelectedFlags="{Binding Groups, Mode=TwoWay, Converter={StaticResource EnumCastConverter}}" />

                        <!--  Row - Background:  -->
                        <TextBlock Text="{lex:Loc Background}"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <sf:ColorPickerPalette Name="bgColor"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="200"
                            Height="35"
                            Margin="0,5"
                            HorizontalAlignment="Left"
                            AutomaticColorVisibility="Collapsed"
                            CustomColorsCollection="{Binding NewColorCollection}"
                            CustomHeaderText="Udvalgte Farver"
                            CustomHeaderVisibility="Visible"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            SetCustomColors="True"
                            StandardPanelVisibility="Collapsed"
                            ThemePanelVisibility="Collapsed"
                            Color="{Binding NewSetting.BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Row - Foreground:  -->
                        <TextBlock Text="{lex:Loc Foreground}"
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <sf:ColorPickerPalette Name="fgColor"
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="200"
                            Height="35"
                            Margin="0,5"
                            HorizontalAlignment="Left"
                            AutomaticColorVisibility="Collapsed"
                            CustomColorsCollection="{Binding NewColorCollection}"
                            CustomHeaderText="Udvalgte Farver"
                            CustomHeaderVisibility="Visible"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            SetCustomColors="True"
                            StandardPanelVisibility="Collapsed"
                            ThemePanelVisibility="Collapsed"
                            Color="{Binding NewSetting.ForegroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


                        <!--  Row - sound:  -->
                        <TextBlock Text="{lex:Loc Sound}"
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,5" />

                        <WrapPanel Grid.Row="3" Grid.Column="1">
                            <ComboBox
                                Width="120"
                                Margin="0,5"
                                cal:Message.Attach="[Event SelectionChanged] = [Action SoundChanged()]"
                                ItemsSource="{x:Static audio:AudioResources.Sounds}"
                                SelectedItem="{Binding Sound}" />

                            <Slider x:Name="volume"
                                Width="200"
                                Margin="0,5"
                                HorizontalAlignment="Left"
                                cal:Message.Attach="[Event ValueChanged] = [Action VolumeChanged($eventArgs)]"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>

                        <!--  Row - use preset:  -->
                        <TextBlock Text="{lex:Loc UsePreset}"
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,5,0,5"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Row="4"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            Orientation="Horizontal">

                            <ComboBox
                                Width="120"
                                Margin="0,5"
                                IsEditable="False"
                                ItemsSource="{Binding Configuration.PresetsView}"
                                SelectedItem="{Binding SelectedPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                                <!--  Dropdown-list: Text only, no color here  -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>

                                <!--  Gør dropdown-list always black  -->
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="Black" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                                <!--  Color only selected item  -->
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Foreground" Value="{Binding DataContext.NewSetting.ChangedProperties, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ContainsToBrush}, ConverterParameter=Name}" />
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <Button
                                Width="28"
                                Margin="4,5,0,5"
                                cal:Message.Attach="[Event Click] = [Action AddPreset]"
                                Content="+"
                                ToolTip="{lex:Loc CreateNewPreset}" />

                            <Button
                                Width="28"
                                Margin="4,5,0,5"
                                cal:Message.Attach="[Event Click] = [Action SavePreset]"
                                Content="💾"
                                ToolTip="{lex:Loc SavePreset}" />

                            <Button
                                Width="28"
                                Margin="4,5,0,5"
                                cal:Message.Attach="[Event Click] = [Action DeletePreset]"
                                Content="🗑"
                                IsEnabled="{Binding CustomPreset}"
                                ToolTip="{lex:Loc DeletePreset}" />
                        </StackPanel>

                        <!--  Row - Teammatch:  -->
                        <TextBlock x:Name="chkTeams" Text="{lex:Loc TeamMatch}"
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <CheckBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="0,5"
                            Foreground="{Binding ChangedProperties, Converter={StaticResource ContainsToBrush}, ConverterParameter=TeamMatch}"
                            IsChecked="{Binding TeamMatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Row - Rounds:  -->
                        <TextBlock Text="{lex:Loc Rounds}"
                            Grid.Row="6"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Row="6"
                            Grid.Column="1"
                            Margin="0,5"
                            Orientation="Horizontal">
                            <TextBox x:Name="txtRounds" Text="{Binding Rounds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="50"
                                Margin="0,0,4,0"
                                Foreground="{Binding ChangedProperties, Converter={StaticResource ContainsToBrush}, ConverterParameter=Rounds}" />
                            <TextBlock Text="{lex:Loc By}"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center" />
                            <TextBox Text="{Binding BoardsPerRound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="50"
                                Margin="0,0,4,0"
                                Foreground="{Binding ChangedProperties, Converter={StaticResource ContainsToBrush}, ConverterParameter=BoardsPerRound}" />
                            <TextBlock VerticalAlignment="Center" Text="spil." />
                        </StackPanel>

                        <!--  Break after round  -->
                        <TextBlock Text="{lex:Loc BreakAfterRound}"
                            Grid.Row="7"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <TextBox Text="{Binding BreakAfterRound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Grid.Row="7"
                            Grid.Column="1"
                            Width="50"
                            Margin="0,5"
                            HorizontalAlignment="Left"
                            Foreground="{Binding ChangedProperties, Converter={StaticResource ContainsToBrush}, ConverterParameter=BreakAfterRound}" />

                        <!--  Row - time per round:  -->
                        <TextBlock Text="{lex:Loc TimePerRound}"
                            Grid.Row="8"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Row="8"
                            Grid.Column="1"
                            Margin="0,5"
                            Orientation="Horizontal">
                            <TextBox Text="{Binding Hours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="40"
                                Margin="0,0,2,0"
                                Foreground="{Binding ChangedProperties, Converter={StaticResource ContainsToBrush}, ConverterParameter=Hours}" />
                            <TextBlock VerticalAlignment="Center" Text=":" />
                            <TextBox Text="{Binding Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="40"
                                Margin="2,0,2,0"
                                Foreground="{Binding ChangedProperties, Converter={StaticResource ContainsToBrush}, ConverterParameter=Minutes}" />
                            <TextBlock VerticalAlignment="Center" Text=":" />
                            <TextBox Text="{Binding Seconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="40"
                                Margin="2,0,2,0"
                                Foreground="{Binding ChangedProperties, Converter={StaticResource ContainsToBrush}, ConverterParameter=Seconds}" />
                            <TextBlock Text="(tt:mm:ss)"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <!--  Row - Warning - do not start new boards  -->
                        <TextBlock Text="{lex:Loc WarningDoNotStartNewGames}"
                            Grid.Row="9"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Row="9"
                            Grid.Column="1"
                            Margin="0,5"
                            Orientation="Horizontal">
                            <TextBox Text="{Binding WarningMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="50"
                                Foreground="{Binding ChangedProperties, Converter={StaticResource ContainsToBrush}, ConverterParameter=WarningMinutes}" />
                            <TextBlock Text="{lex:Loc Minutes}"
                                Margin="4,0,0,0"
                                VerticalAlignment="top" />
                        </StackPanel>


                        <!--  Row - transition time:  -->
                        <TextBlock Text="{lex:Loc TransitionTime}"
                            Grid.Row="10"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />


                        <StackPanel
                            Grid.Row="10"
                            Grid.Column="1"
                            Margin="0,5"
                            Orientation="Horizontal">
                            <TextBox Text="{Binding TransitionMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="50"
                                Foreground="{Binding ChangedProperties, Converter={StaticResource ContainsToBrush}, ConverterParameter=TransitionMinutes}" />
                            <TextBlock Text="{lex:Loc Minutes}"
                                Margin="4,0,0,0"
                                VerticalAlignment="top" />
                        </StackPanel>

                        <!--  Row - Breake minutes:  -->
                        <TextBlock Text="{lex:Loc BreakMinutes}"
                            Grid.Row="11"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Row="11"
                            Grid.Column="1"
                            Orientation="Horizontal">

                            <TextBox Text="{Binding BreakMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="50"
                                Margin="0,5"
                                Foreground="{Binding ChangedProperties, Converter={StaticResource ContainsToBrush}, ConverterParameter=BreakMinutes}" />

                            <TextBlock Text="{lex:Loc Minutes}"
                                Margin="4,0,0,0"
                                VerticalAlignment="top" />
                        </StackPanel>

                        <!--  Row - Break message  -->
                        <TextBlock Text="{lex:Loc BreakMessage}"
                            Grid.Row="12"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />


                        <TextBox Text="{Binding PauseMessage, Mode=TwoWay}"
                            Grid.Row="12"
                            Grid.Column="1"
                            Width="320"
                            MaxHeight="50"
                            Margin="0,5"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />


                        <!--  Row - End Greetings:  -->
                        <TextBlock Text="{lex:Loc EndGreetingTop}"
                            Grid.Row="13"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <TextBox Text="{Binding EndGreetingTop, Mode=TwoWay}"
                            Grid.Row="13"
                            Grid.Column="1"
                            Width="320"
                            MaxHeight="50"
                            Margin="0,5"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />

                        <!--  Row - End Greeting Bottom  -->
                        <TextBlock Text="{lex:Loc EndGreetingBottom}"
                            Grid.Row="14"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <TextBox Text="{Binding EndGreetingBottom, Mode=TwoWay}"
                            Grid.Row="14"
                            Grid.Column="1"
                            Width="320"
                            MaxHeight="50"
                            Margin="0,5"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />

                        <!--  Row - Playing Time:  -->
                        <TextBlock Text="{lex:Loc ExpectedPlayingTime}"
                            Grid.Row="15"
                            Grid.Column="0"
                            Margin="0,5"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Row="15"
                            Grid.Column="1"
                            Orientation="Horizontal">

                            <!--<TextBlock Margin="0,4" Text="kl. " />-->

                            <TextBox Text="{Binding DataContext.Configuration.StartTime, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,4"
                                FontWeight="Bold" />

                            <TextBlock Margin="0,4" Text=" - " />

                            <TextBlock Text="{Binding DataContext.EndTime, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,4"
                                HorizontalAlignment="Left"
                                FontWeight="Bold" />


                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                cal:Message.Attach="[Event Click] = [Action Cancel]"
                Content="{lex:Loc btnCancel}"
                IsCancel="True" />
            <Button
                Width="80"
                cal:Message.Attach="[Event Click] = [Action AcceptSetting]"
                Content="{lex:Loc btnAccept}"
                IsDefault="True" />
        </StackPanel>
    </Grid>

</Window>

