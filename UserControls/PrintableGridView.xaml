<UserControl
    x:Class="DBF.UserControls.PrintableGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DBF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <StackPanel>
            <TextBlock
                Margin="0,0,0,20"
                FontSize="28"
                FontWeight="Bold"
                Text="Navneliste" />

            <DataGrid
                AutoGenerateColumns="False"
                ColumnHeaderHeight="30"
                HeadersVisibility="Column"
                ItemsSource="{Binding Pairs}"
                RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding PairNoStr}"
                        Header="Navn" />
                    <DataGridTextColumn
                        Width="300"
                        Binding="{Binding PairName}"
                        Header="Adresse" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
