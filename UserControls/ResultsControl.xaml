<UserControl x:Name="root"
    x:Class="DBF.UserControls.ResultsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:help="clr-namespace:DBF.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:DBF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Margin="8,0,8,0"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0"
            Margin="5,5,0,0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="Resultater:  " />
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="{Binding Date, StringFormat='{}{0:d. MMM yyyy kl. HH:mm}'}" />
        </StackPanel>

        <CheckBox Grid.Column="1" Grid.Row="0"
            Margin="30,6,0,0"
            Content="Vis som én række"
            FontSize="16"
            IsChecked="{Binding ShowAsOneGroup, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding ShowAsOneGroupVisibility}" />

        <syncfusion:SfDataGrid Name="dgTeams" Grid.ColumnSpan="2" Grid.Row="1"
            Margin="0,0,0,10"
            Padding="5,0,5,0"
            AllowEditing="False"
            AllowResizingColumns="True"
            AllowTriStateSorting="False"
            AlternatingRowStyle="{StaticResource alternatingRowStyle}"
            AlternationCount="2"
            AutoExpandGroups="True"
            AutoGenerateColumns="False"
            CaptionSummaryRowStyle="{StaticResource captionRowStyle}"
            ColumnSizer="Auto"
            FilterRowPosition="None"
            FontSize="14"
            ItemsSource="{Binding Teams}"
            ScrollViewer.CanContentScroll="True"
            Visibility="{Binding Teams, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">


            <syncfusion:SfDataGrid.Columns>

                <syncfusion:GridTextColumn
                    HeaderText="Rk"
                    IsHidden="True"
                    MappingName="Title" />

                <syncfusion:GridNumericColumn
                    HeaderText="Nr"
                    MappingName="TeamNo"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn
                    AllowSorting="False"
                    HeaderText="Hold"
                    MappingName="TeamName"
                    MinimumWidth="350" />

                <!--  Kamp Resultat  -->
                <syncfusion:GridTemplateColumn
                    CellTemplate="{StaticResource ColumnSeparatorTemplate}"
                    Width="2"
                    MappingName="Separator" />

                <syncfusion:GridTextColumn
                    Width="100"
                    CellStyle="{StaticResource CenteredCourierNew}"
                    HeaderText="KP"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="MatchResult"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn
                    HeaderText="Imps"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="ImpScore"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn
                    HeaderText="Mod Hold"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="OpponentTeamNo"
                    TextAlignment="Center" />

                <syncfusion:GridNumericColumn
                    HeaderText="Stilling"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="TournamentRank"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />

                <syncfusion:GridNumericColumn
                    HeaderText="KP Total"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="TotalKP"
                    NumberDecimalDigits="2"
                    TextAlignment="Center" />

            </syncfusion:SfDataGrid.Columns>


            <syncfusion:SfDataGrid.SortColumnDescriptions>
                <syncfusion:SortColumnDescription ColumnName="Title" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="TournamentRank" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="TeamNo" SortDirection="Ascending" />
            </syncfusion:SfDataGrid.SortColumnDescriptions>

            <syncfusion:SfDataGrid.GroupColumnDescriptions>
                <syncfusion:GroupColumnDescription ColumnName="Title" />
            </syncfusion:SfDataGrid.GroupColumnDescriptions>
        </syncfusion:SfDataGrid>

        <syncfusion:SfDataGrid Name="dgPairs" Grid.ColumnSpan="2" Grid.Row="2"
            Padding="5,0,5,0"
            AllowEditing="False"
            AllowResizingColumns="True"
            AllowTriStateSorting="False"
            AlternatingRowStyle="{StaticResource alternatingRowStyle}"
            AlternationCount="2"
            AutoExpandGroups="True"
            AutoGenerateColumns="False"
            CaptionSummaryRowStyle="{StaticResource captionRowStyle}"
            ColumnSizer="Auto"
            FilterRowPosition="None"
            FontSize="14"
            ItemsSource="{Binding Pairs}"
            ScrollViewer.CanContentScroll="True"
            Visibility="{Binding Pairs, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">

            <!--<i:Interaction.Behaviors>
                <help:SfGridBehavior />
            </i:Interaction.Behaviors>-->

            <syncfusion:SfDataGrid.Columns>

                <syncfusion:GridTextColumn
                    HeaderText="Rk"
                    IsHidden="True"
                    MappingName="Title" />

                <syncfusion:GridNumericColumn
                    HeaderText="Nr"
                    MappingName="PairNo"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn
                    AllowSorting="False"
                    HeaderText="Navne"
                    MappingName="PairName"
                    MinimumWidth="350" />

                <!--  Placering  -->
                <syncfusion:GridTemplateColumn
                    CellTemplate="{StaticResource ColumnSeparatorTemplate}"
                    Width="2"
                    MappingName="Separator" />

                <syncfusion:GridNumericColumn
                    HeaderText="Placering"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="Placering"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn
                    HeaderText="Hac"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="HACRankSection"
                    TextAlignment="Center" />

                <!--  Sektionens Score  -->

                <syncfusion:GridPercentColumn
                    HeaderText="Opnået"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="ActualScore" />

                <syncfusion:GridNumericColumn
                    HeaderText="Score"
                    HorizontalHeaderContentAlignment="Right"
                    MappingName="Result"
                    TextAlignment="Right" />

                <syncfusion:GridNumericColumn
                    Width="60"
                    HeaderText="Hac"
                    HorizontalHeaderContentAlignment="Right"
                    MappingName="DeltaHAC"
                    TextAlignment="Right" />

                <syncfusion:GridTextColumn
                    Width="40"
                    AllowSorting="False"
                    HeaderText="MP"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="MP"
                    TextAlignment="Center" />

                <!--  Tourneringens Score  -->
                <syncfusion:GridTemplateColumn
                    CellTemplate="{StaticResource ColumnSeparatorTemplate}"
                    Width="2"
                    MappingName="Separator2" />

                <syncfusion:GridNumericColumn
                    HeaderText="Rang."
                    HorizontalHeaderContentAlignment="Center"
                    IsHidden="{Binding DataContext.HideTournamentSummery, ElementName=root}"
                    MappingName="TournamentRank"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />

                <syncfusion:GridNumericColumn
                    Width="60"
                    HeaderText="Score"
                    HorizontalHeaderContentAlignment="Right"
                    IsHidden="{Binding DataContext.HideTournamentSummery, ElementName=root}"
                    MappingName="TournamentResult" />

                <syncfusion:GridNumericColumn
                    Width="60"
                    HeaderText="Hac"
                    HorizontalHeaderContentAlignment="Right"
                    IsHidden="{Binding DataContext.HideTournamentSummery, ElementName=root}"
                    MappingName="HACTotal" />
            </syncfusion:SfDataGrid.Columns>

            <syncfusion:SfDataGrid.StackedHeaderRows>
                <syncfusion:StackedHeaderRow>
                    <syncfusion:StackedHeaderRow.StackedColumns>
                        <syncfusion:StackedColumn ChildColumns="Placering,HACRankSection" HeaderText="Stilling" />
                        <syncfusion:StackedColumn ChildColumns="ExpectedScore,ActualScore,Result,DeltaHAC,MP" HeaderText="Resultat" />
                        <syncfusion:StackedColumn ChildColumns="TournamentRank,TournamentResult,HACTotal" HeaderText="Turneringen" />
                    </syncfusion:StackedHeaderRow.StackedColumns>
                </syncfusion:StackedHeaderRow>
            </syncfusion:SfDataGrid.StackedHeaderRows>

            <syncfusion:SfDataGrid.SortColumnDescriptions>
                <syncfusion:SortColumnDescription ColumnName="Title" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="SectionRank" SortDirection="Ascending" />
            </syncfusion:SfDataGrid.SortColumnDescriptions>

            <syncfusion:SfDataGrid.GroupColumnDescriptions>
                <syncfusion:GroupColumnDescription ColumnName="Title" />
                <syncfusion:GroupColumnDescription ColumnName="SubGroup" />
            </syncfusion:SfDataGrid.GroupColumnDescriptions>

            <!--<syncfusion:SfDataGrid.GroupSummaryRows>
                <syncfusion:GridSummaryRow Name="MySummary" />
            </syncfusion:SfDataGrid.GroupSummaryRows>-->

        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
