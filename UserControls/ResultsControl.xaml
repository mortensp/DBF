<UserControl
    x:Class="DBF.UserControls.ResultsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:help="clr-namespace:DBF.Helpers"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:DBF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:userctl="clr-namespace:DBF.UserControls"
    x:Name="root"
    Margin="8,0,8,0"
    d:DesignHeight="450"
    d:DesignWidth="1200"
    lex:LocalizeDictionary.DesignCulture="da"
    lex:ResxLocalizationProvider.DefaultAssembly="DBF"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <CollectionViewSource x:Key="PairsViewSource" Source="{Binding Pairs, UpdateSourceTrigger=PropertyChanged}" />
        <CollectionViewSource x:Key="TeamsViewSource" Source="{Binding Teams, UpdateSourceTrigger=PropertyChanged}" />

        <!--  proxy that exposes this UserControl.DataContext  -->
        <help:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0"
            Margin="5,5,0,0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="{lex:Loc Results}" />
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="  " />
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="{Binding Date, StringFormat='{}{0:d. MMM yyyy kl. HH:mm}'}" />
        </StackPanel>

        <CheckBox Grid.Row="0" Grid.Column="1"
            Margin="30,6,0,0"
            Content="{lex:Loc chkShowAsOneGroup}"
            FontSize="16"
            IsChecked="{Binding ShowAsOneGroup, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding CollapsedInProjectorView, ElementName=root}" />


        <!--<Button Grid.Row="0" Grid.Column="2"
            Name="btnBreak"
            Click="btnBreak_Click"
            Content="Break" />-->

        <syncfusion:SfDataGrid Grid.Row="1"
            Name="dgTeams"
            Grid.ColumnSpan="2"
            Margin="0,0,0,10"
            Padding="5,0,5,0"
            AllowEditing="False"
            AllowResizingColumns="True"
            AllowTriStateSorting="False"
            AlternatingRowStyle="{StaticResource alternatingRowStyle}"
            AlternationCount="2"
            AutoExpandGroups="True"
            AutoGenerateColumns="False"
            CaptionSummaryRowStyle="{StaticResource captionRowStyle}"
            ColumnSizer="Auto"
            FilterRowPosition="None"
            FontSize="14"
            HeaderRowHeight="25"
            ItemsSource="{Binding Source={StaticResource TeamsViewSource}}"
            ScrollViewer.CanContentScroll="True"
            Visibility="{Binding Teams, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdGroup}"
                    IsHidden="True"
                    MappingName="Group" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdNo}"
                    MappingName="TeamNo"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdTeam}"
                    AllowSorting="False"
                    MappingName="TeamName"
                    MinimumWidth="350" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdOpponentTeam}"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="OpponentTeamNo"
                    TextAlignment="Center" />

                <!--  Kamp Resultat  -->


                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdKP}"
                    Width="100"
                    CellStyle="{StaticResource CenteredCourierNew}"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="MatchResult"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdImps}"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="ImpScore"
                    TextAlignment="Center" />

                <!--  Tournerings stilling  -->
                <syncfusion:GridTemplateColumn
                    Width="2"
                    CellTemplate="{StaticResource ColumnSeparatorTemplate}"
                    MappingName="Separator" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdKPTotal}"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="TotalKP"
                    NumberDecimalDigits="2"
                    TextAlignment="Center" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdTournamentPos}"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="TournamentRank"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />


            </syncfusion:SfDataGrid.Columns>


            <syncfusion:SfDataGrid.SortColumnDescriptions>
                <syncfusion:SortColumnDescription ColumnName="Group" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="TournamentRank" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="TeamNo" SortDirection="Ascending" />
            </syncfusion:SfDataGrid.SortColumnDescriptions>

        </syncfusion:SfDataGrid>

        <syncfusion:SfDataGrid Grid.Row="2"
            Name="dgPairs"
            Grid.ColumnSpan="2"
            Padding="5,0,5,0"
            AllowEditing="False"
            AllowResizingColumns="True"
            AllowTriStateSorting="False"
            AlternatingRowStyle="{StaticResource alternatingRowStyle}"
            AlternationCount="2"
            AutoExpandGroups="True"
            AutoGenerateColumns="False"
            CaptionSummaryRowStyle="{StaticResource captionRowStyle2}"
            ColumnSizer="Auto"
            FilterRowPosition="None"
            FontSize="14"
            HeaderRowHeight="25"
            ItemsSource="{Binding Source={StaticResource PairsViewSource}}"
            ScrollViewer.CanContentScroll="True"
            Visibility="{Binding Pairs, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdGroup}"
                    IsHidden="True"
                    MappingName="Group" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdSubGroup}"
                    IsHidden="True"
                    MappingName="SubGroup" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdNo}"
                    MappingName="PairNo"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdNames}"
                    AllowSorting="False"
                    MappingName="PairName"
                    MinimumWidth="350" />

                <!--  Section Score  -->
                <!--  ViewModelProxyen is needed  -->
                <syncfusion:GridPercentColumn HeaderText="{lex:Loc hdActualPct}"
                    HorizontalHeaderContentAlignment="Center"
                    IsHidden="{Binding Data.ImpsPair, Source={StaticResource ViewModelProxy}}"
                    PercentDecimalDigits="1"
                    ValueBinding="{Binding ActualPct}" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdScore}"
                    HorizontalHeaderContentAlignment="Right"
                    MappingName="Result"
                    NumberDecimalDigits="1"
                    TextAlignment="Right" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdDeltaHAC}"
                    Width="60"
                    HorizontalHeaderContentAlignment="Right"
                    IsHidden="{Binding Data.HideHac, Source={StaticResource ViewModelProxy}}"
                    MappingName="DeltaHAC"
                    NumberDecimalDigits="2"
                    TextAlignment="Right" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdHACPos}"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="HACRankSection"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdMP}"
                    Width="40"
                    AllowSorting="False"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="MP"
                    TextAlignment="Center" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdPos}"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="Position"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />

                <!--  Accumelated Tournament Score  -->
                <syncfusion:GridTemplateColumn
                    Width="2"
                    CellTemplate="{StaticResource ColumnSeparatorTemplate}"
                    MappingName="Separator2" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdTournamentScore}"
                    Width="60"
                    HorizontalHeaderContentAlignment="Right"
                    MappingName="TournamentResult"
                    NumberDecimalDigits="1" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdDeltaHAC}"
                    Width="60"
                    HorizontalHeaderContentAlignment="Right"
                    IsHidden="True"
                    MappingName="HACTotal"
                    NumberDecimalDigits="2" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdPos}"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="TournamentRank"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />

            </syncfusion:SfDataGrid.Columns>

            <syncfusion:SfDataGrid.StackedHeaderRows>
                <syncfusion:StackedHeaderRow>
                    <syncfusion:StackedHeaderRow.StackedColumns>
                        <syncfusion:StackedColumn ChildColumns="ExpectedScore,ActualPct,ActualScore,Result,DeltaHAC,HACRankSection,MP,Position" HeaderText="{lex:Loc hdSection}" />
                        <syncfusion:StackedColumn ChildColumns="TournamentRank,TournamentResult,HACTotal" HeaderText="{lex:Loc hdTournament}" />
                    </syncfusion:StackedHeaderRow.StackedColumns>
                </syncfusion:StackedHeaderRow>
            </syncfusion:SfDataGrid.StackedHeaderRows>


            <syncfusion:SfDataGrid.SortColumnDescriptions>
                <syncfusion:SortColumnDescription ColumnName="Group" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="SubGroup" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="Position" SortDirection="Ascending" />
            </syncfusion:SfDataGrid.SortColumnDescriptions>


        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
