<UserControl
    x:Class="DBF.UserControls.StartListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DBF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:help="clr-namespace:DBF.Helpers"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:userctl="clr-namespace:DBF.UserControls"
    x:Name="root"
    d:DesignHeight="450"
    d:DesignWidth="1100"
    lex:LocalizeDictionary.DesignCulture="en-US"
    lex:ResxLocalizationProvider.DefaultAssembly="DBF"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <CollectionViewSource x:Key="PairsViewSource" Source="{Binding Pairs, UpdateSourceTrigger=PropertyChanged}" />
        <CollectionViewSource x:Key="TeamsViewSource" Source="{Binding Teams, UpdateSourceTrigger=PropertyChanged}" />

        <!--  proxy that exposes this UserControl.DataContext  -->
        <help:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
            Margin="5,5,0,0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <TextBlock
                FontSize="{DynamicResource X-LargeFontSize}"
                FontWeight="Bold"
                Text="{lex:Loc StartList}" />

            <TextBlock
                FontSize="{DynamicResource X-LargeFontSize}"
                FontWeight="Bold"
                Text=": " />

            <TextBlock
                FontSize="{DynamicResource X-LargeFontSize}"
                FontWeight="Bold"
                Text="{Binding Date, StringFormat='{}{0:d. MMM yyyy kl. HH:mm}'}" />
        </StackPanel>

        <syncfusion:SfDataGrid Grid.Row="1"
            Name="dgTeams"
            Margin="0,0,0,10"
            AllowEditing="False"
            AllowResizingColumns="True"
            AllowTriStateSorting="False"
            AlternatingRowStyle="{StaticResource alternatingRowStyle}"
            AlternationCount="2"
            AutoExpandGroups="True"
            AutoGenerateColumns="False"
            CaptionSummaryRowStyle="{StaticResource captionRowStyle}"
            ColumnSizer="Auto"
            FilterRowPosition="None"
            FontSize="{DynamicResource LargeFontSize}"
            ItemsSource="{Binding Source={StaticResource TeamsViewSource}}"
            QueryRowHeight="SfDataGrid_QueryRowHeight"
            ScrollViewer.CanContentScroll="True"
            Visibility="{Binding Teams, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource HideCollectionEmptyConverter}}">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdGroup}"
                    IsHidden="True"
                    MappingName="Group" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdNo}"
                    Padding="5,0"
                    MappingName="TeamNo"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdTeam}"
                    x:Name="TeamName"
                    Width="250"
                    Padding="5,0"
                    AllowSorting="False"
                    MappingName="TeamName" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdStartPos}"
                    Padding="5,0"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="StartPos"
                    MinimumWidth="80"
                    TextAlignment="Center" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdHAC}"
                    Padding="5,0"
                    HorizontalHeaderContentAlignment="Right"
                    MappingName="AvgHAC"
                    NumberDecimalDigits="2" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdPlayers}"
                    Padding="5,0"
                    HorizontalHeaderContentAlignment="Left"
                    MappingName="Names"
                    MaximumWidth="600"
                    MinimumWidth="600"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
            </syncfusion:SfDataGrid.Columns>

            <syncfusion:SfDataGrid.SortColumnDescriptions>
                <syncfusion:SortColumnDescription ColumnName="Group" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="TeamNo" SortDirection="Ascending" />
            </syncfusion:SfDataGrid.SortColumnDescriptions>

            <syncfusion:SfDataGrid.GroupColumnDescriptions>
                <syncfusion:GroupColumnDescription ColumnName="Group" />
            </syncfusion:SfDataGrid.GroupColumnDescriptions>

        </syncfusion:SfDataGrid>

        <syncfusion:SfDataGrid Grid.Row="2"
            Name="dgPairs"
            Padding="5,0,5,0"
            AllowEditing="False"
            AllowGrouping="True"
            AllowResizingColumns="True"
            AllowTriStateSorting="False"
            AlternatingRowStyle="{StaticResource alternatingRowStyle}"
            AlternationCount="2"
            AutoExpandGroups="True"
            AutoGenerateColumns="False"
            CaptionSummaryRowStyle="{StaticResource captionRowStyle}"
            ColumnSizer="Auto"
            FilterRowPosition="None"
            FontSize="{DynamicResource LargeFontSize}"
            ItemsSource="{Binding Source={StaticResource PairsViewSource}}"
            NavigationMode="Row"
            ScrollViewer.CanContentScroll="True"
            ShowColumnWhenGrouped="True"
            Visibility="{Binding Pairs, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource HideCollectionEmptyConverter}}">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdGroup}"
                    IsHidden="True"
                    MappingName="Group" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdSubGroup}"
                    IsHidden="True"
                    MappingName="SubGroup" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdNo}"
                    MappingName="PairNo"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdNames}"
                    AllowSorting="False"
                    MappingName="PairName"
                    MinimumWidth="350" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdStartPos}"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="StartPos"
                    TextAlignment="Center" />

                <!--    -->
                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdHAC}"
                    HorizontalHeaderContentAlignment="Right"
                    IsHidden="{Binding Data.HideHac, Source={StaticResource ViewModelProxy}}"
                    MappingName="AvgHAC"
                    NumberDecimalDigits="1" />

                <!--  ViewModelProxyen er nødvendig  -->
                <syncfusion:GridPercentColumn HeaderText="{lex:Loc hdExpectedScore}"
                    HorizontalHeaderContentAlignment="Center"
                    IsHidden="True"
                    MappingName="ExpectedPct"
                    PercentDecimalDigits="2" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdExpectedScore}"
                    HorizontalHeaderContentAlignment="Center"
                    IsHidden="{Binding Data.ImpsPair, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanInvertConverter}}"
                    MappingName="ExpectedScore"
                    NumberDecimalDigits="2" />

                <!--  Tourneringens Score  -->
                <syncfusion:GridTemplateColumn
                    Width="2"
                    CellTemplate="{StaticResource ColumnSeparatorTemplate}"
                    MappingName="Separator2" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdScore}"
                    HorizontalHeaderContentAlignment="Right"
                    IsHidden="{Binding Data.HideTournamentSummery, Source={StaticResource ViewModelProxy}}"
                    MappingName="TournamentResult"
                    NumberDecimalDigits="1" />

                <syncfusion:GridNumericColumn HeaderText="{lex:Loc hdDeltaHAC}"
                    HorizontalHeaderContentAlignment="Right"
                    MappingName="HACTotal"
                    NumberDecimalDigits="2" />

                <syncfusion:GridTextColumn HeaderText="{lex:Loc hdPos}"
                    HorizontalHeaderContentAlignment="Center"
                    IsHidden="{Binding Data.HideTournamentSummery, Source={StaticResource ViewModelProxy}}"
                    MappingName="TournamentRank"
                    TextAlignment="Center" />

            </syncfusion:SfDataGrid.Columns>

            <syncfusion:SfDataGrid.StackedHeaderRows>
                <syncfusion:StackedHeaderRow>
                    <syncfusion:StackedHeaderRow.StackedColumns>
                        <syncfusion:StackedColumn ChildColumns="ExpectedPct,ExpectedScore" HeaderText="{lex:Loc hdSection}" />
                        <syncfusion:StackedColumn ChildColumns="TournamentRank,TournamentResult,HACTotal" HeaderText="{lex:Loc hdTournament}" />
                    </syncfusion:StackedHeaderRow.StackedColumns>
                </syncfusion:StackedHeaderRow>
            </syncfusion:SfDataGrid.StackedHeaderRows>

            <syncfusion:SfDataGrid.SortColumnDescriptions>
                <syncfusion:SortColumnDescription ColumnName="Group" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="SubGroup" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="PairNo" SortDirection="Ascending" />
            </syncfusion:SfDataGrid.SortColumnDescriptions>

            <syncfusion:SfDataGrid.GroupColumnDescriptions>
                <syncfusion:GroupColumnDescription ColumnName="Group" />
                <syncfusion:GroupColumnDescription ColumnName="SubGroup" />
            </syncfusion:SfDataGrid.GroupColumnDescriptions>
        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
