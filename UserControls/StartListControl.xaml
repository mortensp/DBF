<UserControl x:Name="root"
    x:Class="DBF.UserControls.StartListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DBF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:help="clr-namespace:DBF.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:userctl="clr-namespace:DBF.UserControls"
    d:DesignHeight="450"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <CollectionViewSource x:Key="PairsViewSource" Source="{Binding Pairs, UpdateSourceTrigger=PropertyChanged}" />
        <CollectionViewSource x:Key="TeamsViewSource" Source="{Binding Teams, UpdateSourceTrigger=PropertyChanged}" />

        <!--  proxy that exposes this UserControl.DataContext  -->
        <help:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
            Margin="5,5,0,0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="Startliste:  " />
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="{Binding Date, StringFormat='{}{0:d. MMM yyyy kl. HH:mm}'}" />
        </StackPanel>

        <syncfusion:SfDataGrid Name="dgTeams" Grid.Row="1"
            ItemsSource="{Binding Source={StaticResource TeamsViewSource}}"
            Margin="0,0,0,10"
            AllowEditing="False"
            AllowResizingColumns="True"
            AllowTriStateSorting="False"
            AlternatingRowStyle="{StaticResource alternatingRowStyle}"
            AlternationCount="2"
            AutoExpandGroups="True"
            AutoGenerateColumns="False"
            CaptionSummaryRowStyle="{StaticResource captionRowStyle}"
            ColumnSizer="Auto"
            FilterRowPosition="None"
            FontSize="14"
            QueryRowHeight="SfDataGrid_QueryRowHeight"
            ScrollViewer.CanContentScroll="True"
            Visibility="{Binding Teams, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn
                    HeaderText="Rk"
                    IsHidden="True"
                    MappingName="Group" />

                <syncfusion:GridTextColumn
                    Padding="5,0"
                    HeaderText="Nr"
                    MappingName="TeamNo"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn x:Name="TeamName"
                    Width="250"
                    Padding="5,0"
                    AllowSorting="False"
                    HeaderText="Hold"
                    MappingName="TeamName" />

                <syncfusion:GridTextColumn
                    Padding="5,0"
                    HeaderText="Start"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="StartPos"
                    MinimumWidth="80"
                    TextAlignment="Center" />

                <syncfusion:GridNumericColumn
                    Padding="5,0"
                    HeaderText="Hac"
                    HorizontalHeaderContentAlignment="Right"
                    MappingName="AvgHAC" />

                <syncfusion:GridTextColumn
                    Padding="5,0"
                    HeaderText="Spillere"
                    HorizontalHeaderContentAlignment="Left"
                    MappingName="Names"
                    MaximumWidth="600"
                    MinimumWidth="600"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
            </syncfusion:SfDataGrid.Columns>

            <syncfusion:SfDataGrid.SortColumnDescriptions>
                <syncfusion:SortColumnDescription ColumnName="Group" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="TeamNo" SortDirection="Ascending" />
            </syncfusion:SfDataGrid.SortColumnDescriptions>

            <!--<syncfusion:SfDataGrid.GroupColumnDescriptions>
                <syncfusion:GroupColumnDescription ColumnName="Group" />
                <syncfusion:GroupColumnDescription ColumnName="SubGroup" />
            </syncfusion:SfDataGrid.GroupColumnDescriptions>-->
        </syncfusion:SfDataGrid>

        <syncfusion:SfDataGrid Name="dgPairs" Grid.Row="2"
            ItemsSource="{Binding Source={StaticResource PairsViewSource}}"
            Padding="5,0,5,0"
            AllowEditing="False"
            AllowGrouping="True"
            AllowResizingColumns="True"
            AllowTriStateSorting="False"
            AlternatingRowStyle="{StaticResource alternatingRowStyle}"
            AlternationCount="2"
            AutoExpandGroups="True"
            AutoGenerateColumns="False"
            CaptionSummaryRowStyle="{StaticResource captionRowStyle}"
            ColumnSizer="Auto"
            FilterRowPosition="None"
            FontSize="14"
            NavigationMode="Row"
            ScrollViewer.CanContentScroll="True"
            ShowColumnWhenGrouped="True"
            ShowGroupDropArea="True"
            Visibility="{Binding Pairs, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn
                    HeaderText="Rk"
                    IsHidden="True"
                    MappingName="Group" />

                <syncfusion:GridTextColumn
                    HeaderText="Led"
                    IsHidden="True"
                    MappingName="SubGroup" />

                <syncfusion:GridNumericColumn
                    HeaderText="Nr"
                    MappingName="PairNo"
                    NumberDecimalDigits="0"
                    TextAlignment="Center" />

                <syncfusion:GridTextColumn
                    AllowSorting="False"
                    HeaderText="Navne"
                    MappingName="PairName"
                    MinimumWidth="350" />

                <syncfusion:GridTextColumn
                    HeaderText="Start"
                    HorizontalHeaderContentAlignment="Center"
                    MappingName="StartPos"
                    TextAlignment="Center" />

                <syncfusion:GridNumericColumn
                    HeaderText="HAC"
                    HorizontalHeaderContentAlignment="Right"
                    MappingName="AvgHAC" />

                <!--  TODO: Only one of the next two columns will be shown  -->
                <!-- ViewModelProxyen er nødvendig -->
                <syncfusion:GridPercentColumn
                    HeaderText="Forventet"
                    HorizontalHeaderContentAlignment="Center"
                    IsHidden="{Binding Data.ImpsPair, Source={StaticResource ViewModelProxy}}"
                    MappingName="ExpectedScore" />

                <syncfusion:GridNumericColumn
                    HeaderText="Forventet"
                    HorizontalHeaderContentAlignment="Center"
                    IsHidden="{Binding Data.ImpsPair, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanInvertConverter}}"
                    MappingName="ExpectedScore" />

                <!--    -->
                <syncfusion:GridTextColumn
                    HeaderText="Rank."
                    HorizontalHeaderContentAlignment="Center"
                    IsHidden="{Binding DataContext.HideTournamentSummery, ElementName=root}"
                    MappingName="TournamentRank"
                    TextAlignment="Center" />

                <syncfusion:GridNumericColumn
                    HeaderText="Score"
                    HorizontalHeaderContentAlignment="Right"
                    IsHidden="{Binding DataContext.HideTournamentSummery, ElementName=root}"
                    MappingName="TournamentResult" />

                <syncfusion:GridNumericColumn
                    HeaderText="Hac"
                    HorizontalHeaderContentAlignment="Right"
                    IsHidden="{Binding DataContext.HideTournamentSummery, ElementName=root}"
                    MappingName="HACTotal" />

            </syncfusion:SfDataGrid.Columns>

            <syncfusion:SfDataGrid.SortColumnDescriptions>
                <syncfusion:SortColumnDescription ColumnName="Group" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="SubGroup" SortDirection="Ascending" />
                <syncfusion:SortColumnDescription ColumnName="PairNo" SortDirection="Ascending" />
            </syncfusion:SfDataGrid.SortColumnDescriptions>
        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
