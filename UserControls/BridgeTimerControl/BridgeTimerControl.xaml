<UserControl x:Name="root"
    x:Class="DBF.UserControls.BridgeTimerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dm="clr-namespace:DBF.DataModel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userctls="clr-namespace:DBF.UserControls"
    d:Background="white"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10" />
                </Style>
            </Style.Resources>

            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FBFBFB" />
            <Setter Property="Padding" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation
                        Storyboard.TargetName="warning"
                        Storyboard.TargetProperty="Opacity"
                        From="1.0"
                        To="0.4"
                        Duration="0:0:1" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>


    <Grid
        DataContext="{Binding ElementName=root}"
        d:DataContext="{d:DesignInstance Type=userctls:BridgeTimerControl,
                                         IsDesignTimeCreatable=True}"
        Visibility="{Binding Timer.Visibility}">

        <Border
            Margin="8"
            Padding="4"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="8">

            <StackPanel>
                <!--  Timer Display  -->
                <Border Padding="0" CornerRadius="6">
                    <Grid Name="display"
                        Background="{Binding Timer.Background}"
                        TextBlock.FontSize="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                            Margin="0,0,0,4"
                            FontWeight="Bold"
                            Text="{Binding Timer.RoundText}"
                            TextAlignment="Center" />

                        <!--  Close button  -->
                        <Button x:Name="btnClose" Grid.Row="0" Grid.Column="2"
                            Width="24"
                            Height="24"
                            Margin="0,-4,-4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="btnClose_Click"
                            Content="X"
                            Cursor="Hand"
                            ToolTip="Luk uret og sluk"
                            Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Center"
                            FontSize="44"
                            FontWeight="Bold"
                            Text="{Binding Timer.Time}" />

                        <TextBlock x:Name="warning" Grid.Row="1" Grid.Column="2"
                            Visibility="{Binding Timer.WarningVisiblity}">
                            <Canvas
                                Width="31"
                                Height="31"
                                Margin="0,16">
                                <Polygon
                                    Fill="Yellow"
                                    Points="15,0 30,30 0,30"
                                    Stroke="Black"
                                    StrokeThickness="2" />
                                <TextBlock
                                    Margin="11,0,0,0"
                                    HorizontalAlignment="Right"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    Text="!" />
                            </Canvas>
                        </TextBlock>

                        <TextBlock x:Name="info" Grid.Row="3" Grid.Column="1"
                            MaxWidth="400"
                            MaxHeight="150"
                            Margin="0,0,0,4"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Binding Timer.Info}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                            <TextBlock x:Name="group" Grid.Row="5" Grid.Column="1"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontWeight="Bold"
                            Text="{Binding Timer.GroupStr}" />

                        </Grid>
                </Border>

                <!--  Timer Control Buttons  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding ButtonsVisibility}">
                    <Button x:Name="btnSetting"
                        Margin="2,0,20,2"
                        Click="BtnSetting_Click"
                        Content="⚙"
                        ToolTip="Indstil uret" />

                    <Button x:Name="btnStart"
                        Margin="2"
                        Click="BtnStart_Click"
                        Content="▶"
                        ToolTip="Start uret" />

                    <Button x:Name="btnBack"
                        Margin="2"
                        Click="BtnBack_Click"
                        Content="⏮"
                        ToolTip="Genstart Runden" />

                    <Button x:Name="btnPause"
                        Margin="2"
                        Click="BtnPause_Click"
                        Content="⏸"
                        ToolTip="Sæt uret på Pause" />

                    <Button x:Name="btnForward"
                        Margin="2"
                        Click="BtnForward_Click"
                        Content="⏭"
                        ToolTip="Næste Runden" />

                    <Button x:Name="btnStop"
                        Margin="2"
                        Click="BtnLessTime_Click"
                        ToolTip="Afkort Runden">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒" />
                            <TextBlock Margin="2,0,0,0" Text="↓" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnMoreTime"
                        Margin="2"
                        Click="BtnMoreTime_Click"
                        ToolTip="Give mere tid i Runden">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒" />
                            <TextBlock Margin="2,0,0,0" Text="↑" />
                        </StackPanel>
                    </Button>

                    <WrapPanel Margin="20,2,2,2">
                        <Button x:Name="btnUp"
                            Margin="2"
                            Click="BtnUp_Click"
                            Content="↑"
                            ToolTip="Flyt uret op"
                            Visibility="{Binding Timer.ShowUpButton}" />

                        <Button x:Name="btnDown"
                            Margin="2"
                            Click="BtnDown_Click"
                            Content="↓"
                            ToolTip="Flyt uret ned"
                            Visibility="{Binding Timer.ShowDownButton}" />
                    </WrapPanel>


                    <Button x:Name="btnReset"
                        Margin="20,2,2,2"
                        Click="BtnReset_Click"
                        Content="&#81;"
                        FontFamily="Wingdings 3"
                        ToolTip="Indlæs valgte indstillinger" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
