<UserControl
    x:Class="DBF.UserControls.BridgeTimerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dm="clr-namespace:DBF.DataModel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sf="http://schemas.syncfusion.com/wpf"
    xmlns:userctls="clr-namespace:DBF.UserControls"
    x:Name="root"
    d:Background="white"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10" />
                </Style>
            </Style.Resources>

            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FBFBFB" />
            <Setter Property="Padding" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation
                        Storyboard.TargetName="warning"
                        Storyboard.TargetProperty="Opacity"
                        From="1.0"
                        To="0.4"
                        Duration="0:0:1" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>


    <Grid
        d:DataContext="{d:DesignInstance Type=userctls:BridgeTimerControl,
                                         IsDesignTimeCreatable=True}"
        DataContext="{Binding ElementName=root}"
        Visibility="{Binding Timer.Visibility}">

        <Border
            Margin="8"
            Padding="4"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <!--  fylder resten af højden  -->
                    <RowDefinition Height="Auto" />
                    <!--  knapper i bunden  -->
                </Grid.RowDefinitions>

                <!--  Timer Display i row 0  -->
                <Border
                    Grid.Row="0"
                    Padding="0"
                    CornerRadius="6">
                    <Grid
                        Name="display"
                        Background="{Binding Timer.Background}"
                        TextBlock.FontSize="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            FontWeight="Bold"
                            Text="{Binding Timer.RoundText}"
                            TextAlignment="Center" />

                        <!--  Close button  -->
                        <Button
                            x:Name="btnClose"
                            Grid.Row="0"
                            Grid.Column="2"
                            Width="24"
                            Height="24"
                            Margin="0,-4,-4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="btnClose_Click"
                            Content="X"
                            Cursor="Hand"
                            ToolTip="Luk uret og sluk"
                            Visibility="{Binding Timer.CanClose, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!--  Row - Time  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Center"
                            FontSize="44"
                            FontWeight="Bold"
                            Text="{Binding Timer.Time}" />

                        <TextBlock
                            x:Name="warning"
                            Grid.Row="1"
                            Grid.Column="2"
                            Visibility="{Binding Timer.WarningVisiblity}">
                            <Canvas
                                Width="31"
                                Height="31"
                                Margin="0,16">
                                <Polygon
                                    Fill="Yellow"
                                    Points="15,0 30,30 0,30"
                                    Stroke="Black"
                                    StrokeThickness="2" />
                                <TextBlock
                                    Margin="11,0,0,0"
                                    HorizontalAlignment="Right"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    Text="!" />
                            </Canvas>
                        </TextBlock>

                        <!--  Row - Info  -->
                        <TextBlock
                            x:Name="info"
                            Grid.Row="3"
                            Grid.Column="1"
                            MaxWidth="400"
                            MaxHeight="150"
                            Margin="0,0,0,4"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Binding Timer.Info}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="group"
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontWeight="Bold"
                            Text="{Binding Timer.GroupStr}" />

                    </Grid>
                </Border>

                <!--  Timer Control Buttons i row 1  -->
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Visibility="{Binding ButtonsVisibility}">

                    <Button
                        x:Name="btnSetting"
                        Margin="2,0,30,2"
                        Click="BtnSetting_Click"
                        Content="⚙"
                        ToolTip="Indstil uret">
                        <sf:SfBadge.Badge>
                            <sf:SfBadge
                                x:Name="badge"
                                Background="LightBlue"
                                Foreground="Black"
                                HorizontalAnchor="Outside"
                                HorizontalPosition="0.55" />
                        </sf:SfBadge.Badge>
                    </Button>

                    <Button
                        x:Name="btnStart"
                        Margin="2"
                        Click="BtnStart_Click"
                        Content="▶"
                        IsEnabled="{Binding Timer.IsEnded, Converter={StaticResource BooleanInvertConverter}}"
                        ToolTip="Start uret. Hold Shift nede for at starte alle urene" />

                    <Button
                        x:Name="btnBack"
                        Margin="2"
                        Click="BtnBack_Click"
                        Content="⏮"
                        IsEnabled="{Binding Timer.IsStarted}"
                        ToolTip="Genstart Runden. Hold Shift nede for at Genstarts Runden på alle urene" />

                    <Button
                        x:Name="btnPause"
                        Margin="2"
                        Click="BtnPause_Click"
                        Content="⏸"
                        IsEnabled="{Binding Timer.IsEnded, Converter={StaticResource BooleanInvertConverter}}"
                        ToolTip="Sæt uret på Pause. Hold Shift nede for at Pause alle urene" />

                    <Button
                        x:Name="btnForward"
                        Margin="2"
                        Click="BtnForward_Click"
                        Content="⏭"
                        IsEnabled="{Binding Timer.IsEnded, Converter={StaticResource BooleanInvertConverter}}"
                        ToolTip="Næste Runden. Hold Shift nedGå Tilbage på alle urene" />

                    <Button
                        x:Name="btnLessTime"
                        Margin="2"
                        Click="BtnLessTime_Click"
                        IsEnabled="{Binding Timer.IsEnded, Converter={StaticResource BooleanInvertConverter}}"
                        ToolTip="Afkort Runden. Hold Shift nede for at Afkorte tiden på alle urene">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒" />
                            <TextBlock Margin="2,0,0,0" Text="↓" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="btnMoreTime"
                        Margin="2"
                        Click="BtnMoreTime_Click"
                        IsEnabled="{Binding Timer.IsEnded, Converter={StaticResource BooleanInvertConverter}}"
                        ToolTip="Give mere tid i Runden. Hold Shift nede for at Mere tid på alle urene">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒" />
                            <TextBlock Margin="2,0,0,0" Text="↑" />
                        </StackPanel>
                    </Button>

                    <WrapPanel Margin="20,2,2,2">
                        <Button
                            x:Name="btnUp"
                            Margin="2"
                            Click="BtnUp_Click"
                            Content="↑"
                            ToolTip="Flyt uret op"
                            Visibility="{Binding Timer.ShowUpButton}" />

                        <Button
                            x:Name="btnDown"
                            Margin="2"
                            Click="BtnDown_Click"
                            Content="↓"
                            ToolTip="Flyt uret ned"
                            Visibility="{Binding Timer.ShowDownButton}" />
                    </WrapPanel>


                    <Button
                        x:Name="btnReset"
                        Margin="20,2,2,2"
                        Click="BtnReset_Click"
                        Content="&#81;"
                        FontFamily="Wingdings 3"
                        ToolTip="Indlæs valgte indstillinger. Hold Shift nede for at Indlæse indstillinger for alle urene" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
