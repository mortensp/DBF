<UserControl
    x:Class="DBF.UserControls.TimersPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DBF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userctls="clr-namespace:DBF.UserControls"
    x:Name="root"
    d:Background="White"
    Loaded="userControl_Loaded"
    mc:Ignorable="d">

    <!--<UserControl.Resources>
        <conv:TimerSelectorConverter x:Key="TimerSelectorConverter" />
    </UserControl.Resources>-->

    <Grid d:DataContext="{d:DesignInstance Type=userctls:TimersPanel, IsDesignTimeCreatable=True}" DataContext="{Binding ElementName=root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <userctls:BridgeTimerControl Grid.Row="0" Grid.Column="0"
            ButtonsVisibility="{Binding ButtonsVisibility}"
            BridgeTimer="{Binding BridgeTimer0}" />

        <userctls:BridgeTimerControl Grid.Row="0" Grid.Column="1"
            ButtonsVisibility="{Binding ButtonsVisibility}"
            BridgeTimer="{Binding BridgeTimer1}" />

        <userctls:BridgeTimerControl Grid.Row="1" Grid.Column="0"
            ButtonsVisibility="{Binding ButtonsVisibility}"
            BridgeTimer="{Binding BridgeTimer2}" />

        <userctls:BridgeTimerControl Grid.Row="1" Grid.Column="1"
            ButtonsVisibility="{Binding ButtonsVisibility}"
            BridgeTimer="{Binding BridgeTimer3}" />
    </Grid>

</UserControl>