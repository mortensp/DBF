<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!-- Du må ikke rette i denne sektion -->
	<configSections>
		<sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
			<section name="DBF.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
		</sectionGroup>
	</configSections>

	<!-- Her kan du angive dine bruge valg -->
	<userSettings>
		<DBF.Properties.Settings>
			<setting name="DisplaySecounds" serializeAs="String">
				<!-- Antal sekunder mellem automatisk skift af visning -->
				<value>20</value>
			</setting>

			<setting name="MaxRows" serializeAs="String">
				<!-- Maksimalt antal rækker i en liste på projektoren -->
				<value>20</value>
			</setting>

			
			<!-- resten er nogle applikationsindstillinger, som kun anvendes første gang programmet starter -->
			<setting name="WindowTop" serializeAs="String">
				<value>400</value>
			</setting>
			<setting name="WindowLeft" serializeAs="String">
				<value>400</value>
			</setting>
			<setting name="WindowHeight" serializeAs="String">
				<value>1100</value>
			</setting>
			<setting name="WindowWidth" serializeAs="String">
				<value>1000</value>
			</setting>
			<setting name="WindowState" serializeAs="String">
				<value>0</value>
			</setting>

		</DBF.Properties.Settings>
	</userSettings>
</configuration>