<Window
    x:Class="DBF.Services.Print.PrintPreviewWindow2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Print Preview"
    Width="1000"
    Height="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Indstillinger til papirstørrelse  -->
        <StackPanel
            Margin="10"
            Background="#F5F5F5"
            Orientation="Horizontal">
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                Text="Papirstørrelse:" />
            <ComboBox
                x:Name="ComboPaperSize"
                Width="120"
                SelectionChanged="OnPageSetupChanged">
                <ComboBoxItem Content="A4" IsSelected="True" />
                <ComboBoxItem Content="Letter" />
                <ComboBoxItem Content="A5" />
            </ComboBox>

            <TextBlock
                Margin="15,0,5,0"
                VerticalAlignment="Center"
                Text="Orientering:" />
            <ComboBox
                x:Name="ComboOrientation"
                Width="100"
                SelectionChanged="OnPageSetupChanged">
                <ComboBoxItem Content="Portræt" IsSelected="True" />
                <ComboBoxItem Content="Liggende" />
            </ComboBox>

            <Button
                Margin="20,0"
                Padding="15,2"
                Background="#007ACC"
                Click="Print_Click"
                Content="Udskriv..."
                Foreground="White" />
        </StackPanel>

        <!--  Preview komponenten som modtager din FixedDocumentSequence  -->
        <DocumentViewer x:Name="MyDocumentViewer" Grid.Row="1">
            <DocumentViewer.Resources>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <Trigger Property="Name" Value="PART_FindToolBarHost">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DocumentViewer.Resources>
        </DocumentViewer>
    </Grid>
</Window>
