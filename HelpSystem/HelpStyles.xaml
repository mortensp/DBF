<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:help="clr-namespace:DBF.HelpSystem"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--  Light theme (Windows 11)  -->
    <SolidColorBrush x:Key="TitleBarBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TitleBarForeground" Color="#1C1C1C" />
    <SolidColorBrush x:Key="TitleBarHover" Color="#E7E7E7" />
    <SolidColorBrush x:Key="TitleBarPressed" Color="#C9C9C9" />

    <!--  TitleBarButtonStyle  -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="29" />
        <Setter Property="Height" Value="29" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource TitleBarHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource TitleBarPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  CloseButtonStyle  -->
    <Style
        x:Key="CloseButtonStyle"
        BasedOn="{StaticResource TitleBarButtonStyle}"
        TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#C42b1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#C50F1F" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  HelpWindow Style  -->
    <Style
        x:Key="HelpWindowStyle"
        BasedOn="{StaticResource {x:Type Window}}"
        TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Padding" Value="0" />

        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome
                    CaptionHeight="29"
                    CornerRadius="8"
                    GlassFrameThickness="0"
                    ResizeBorderThickness="6" />
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border
                        Background="White"
                        BorderBrush="#D0D0D0"
                        BorderThickness="0">
                        <Grid Margin="5,3,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="29" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  =========  -->
                            <!--  TitleBar  -->
                            <!--  =========  -->
                            <Grid Grid.Row="0" Background="{StaticResource TitleBarBackground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Left side of TilteBar  -->
                                <WrapPanel Grid.Column="0"
                                    Margin="8,0,8,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">

                                    <!--  Ikon  -->
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Margin="0,5,5,0"
                                        VerticalAlignment="Center"
                                        Source="{TemplateBinding Icon}" />

                                    <!--  Titel + Drag  -->
                                    <!--<Border
                                        xmlns:cal="http://www.caliburnproject.org"
                                        cal:Message.Attach="[Event MouseLeftButtonDown] = [Action TitleBarDrag($eventArgs)]"
                                        Background="Transparent">-->
                                    <TextBlock
                                        Margin="2,6,2,0"
                                        Foreground="#333"
                                        Text="{TemplateBinding Title}" />
                                    <!--</Border>-->
                                </WrapPanel>

                                <!--  Right side of TilteBar  -->
                                <StackPanel
                                    Margin="0,0,5,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                                    <!--  Help  -->
                                    <Button
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        help:HelpBehavior.Attach="True"
                                        ToolTip="{lex:Loc tbHelp}">
                                        <!--<TextBlock Text="?" />-->
                                        <icons:MaterialDesign
                                            Width="12"
                                            Height="12"
                                            Kind="QuestionMarkOutline" />

                                    </Button>

                                    <!--  Minimize  -->
                                    <Button
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        help:WindowCommandsBehavior.MinimizeCommand="True"
                                        ToolTip="{lex:Loc tbMinimize}">
                                        <TextBlock Text="−" />
                                    </Button>

                                    <!--  Maximize  -->
                                    <Button
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        help:WindowCommandsBehavior.MaximizeCommand="True"
                                        ToolTip="{lex:Loc tbMaximize}">
                                        <TextBlock Text="☐" />
                                    </Button>

                                    <!--  Close  -->
                                    <Button
                                        Style="{StaticResource CloseButtonStyle}"
                                        help:WindowCommandsBehavior.CloseCommand="True"
                                        ToolTip="{lex:Loc tbClose}">
                                        <TextBlock Text="✕" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!--  ============  -->
                            <!--  Client Area  -->
                            <!--  ============  -->
                            <ContentPresenter Grid.Row="1" />

                        </Grid>
                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>